    {
      "parameters": {
        "jsCode": "const payload = JSON.parse($input.item.json.body.payload);\nconst actionId = payload.actions[0].action_id;\nconst value = payload.actions[0].value || \"\";\n\nlet docId = null;\nlet email = null;\nlet empName = payload.user.name;\nlet hrChannel = null;\nlet eventName = \"Unknown Event\";\nlet eventDate = \"Unknown Date\";\n\n// По умолчанию ставим крестик (если сотрудник НЕ выбрал пункт)\nlet checkA = \"☒\";\nlet checkB = \"☒\";\nlet checkC = \"☒\";\n\n// Если нажал HR\nif (actionId === \"hr_send\") {\n  const parts = value.split(\"|\");\n  docId = parts[0];\n  email = parts[1];\n  empName = parts[2];\n  eventName = parts[3] || \"Unknown Event\"; \n  eventDate = parts[4] || \"Unknown Date\";  \n  hrChannel = payload.channel.id;\n} \nelse if (actionId === \"hr_cancel\") {\n  hrChannel = payload.channel.id;\n}\n// Если нажал сотрудник (кнопки Accept или Decline)\nelse if (actionId === \"consent_accept\" || actionId === \"consent_decline\") {\n  const blocksText = JSON.stringify(payload.message.blocks);\n  const match = blocksText.match(/\\/d\\/([a-zA-Z0-9-_]{44})/);\n  docId = match ? match[1] : null;\n  \n  const empParts = value.split(\"|\");\n  hrChannel = empParts[0]; \n  email = empParts[1];     \n  eventName = empParts[2] || \"Unknown Event\"; \n  eventDate = empParts[3] || \"Unknown Date\";  \n\n  // Читаем чекбоксы только при принятии документа\n  if (actionId === \"consent_accept\") {\n    try {\n      // Ищем, какие галочки стояли в момент нажатия кнопки Accept\n      const options = payload.state.values.consent_checkboxes.permissions_list.selected_options;\n      const selected = options.map(opt => opt.value);\n      \n      // Если пункт выбран в Slack, меняем крестик на птичку!\n      if (selected.includes(\"A\")) checkA = \"☑\";\n      if (selected.includes(\"B\")) checkB = \"☑\";\n      if (selected.includes(\"C\")) checkC = \"☑\";\n    } catch(e) {}\n  }\n}\n\n// Делаем имя красивым (с большой буквы, убираем точки)\nempName = empName.replace(/[\\._-]/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase());\n\nreturn {\n  json: {\n    decision: actionId,\n    documentId: docId,\n    employeeEmail: email,\n    employeeName: empName,\n    eventName: eventName,\n    eventDate: eventDate,\n    hrChannelId: hrChannel,\n    channelId: payload.channel.id,\n    checkA: checkA,\n    checkB: checkB,\n    checkC: checkC\n  }\n};"
      },
