    {
      "parameters": {
        "jsCode": "const epics = $('Fetch New Epics').all();\n\nreturn $input.all().map(task => {\n    // 1. Ищем старый ключ эпика (например, PSL-1 или INGR03-10)\n    let oldKey = task.json.fields?.customfield_10014 || task.json.fields?.parent?.key || \"\";\n    task.json.newParentKey = \"\"; \n\n    if (oldKey) {\n        // 2. Пытаемся найти новый скопированный Эпик по скобкам\n        let matchedEpic = epics.find(e => {\n            const summaryText = e.json.fields?.summary || \"\";\n            return summaryText.includes(`[${oldKey}]`);\n        });\n        \n        if (matchedEpic) {\n            // 3. Если нашли (это внутренний Эпик) — отдаем новый ключ (например, INGR03UN-20)\n            task.json.newParentKey = matchedEpic.json.key;\n        } else {\n            // 4. ВОТ ОНО! Если НЕ нашли (это внешний Эпик, как PSL-1) — отдаем старый ключ!\n            task.json.newParentKey = oldKey;\n        }\n    }\n    return task;\n});"
      },
